-- The examples live in the same project so that one `cabal build all` covers
-- them. They used to carry their own stack.yaml files pinned to lts-11/lts-12
-- (GHC 8.2/8.4), which is how they came to stop compiling without anyone
-- noticing.
packages:
  .
  atlas-topology
  sudoko
  gameOfLife
  ising-example
  automata
  maze
  sokoban
  grid-atlas

-- sized-grid-q5fc. Force every package's test suites into the build plan.
--
-- Without this the default solver plan carries test components only for
-- packages whose test deps are already needed by a non-test component --
-- which is sudoko alone (base, grid-sized, lens). Every other suite pulls
-- tasty/QuickCheck/HUnit, so the solver leaves it out, and `cabal test all`
-- then reports "1 of 1 test suites passed" with exit 0 -- the documented
-- quality gate silently skipping the `tests`, `downstream` and `readme`
-- suites it names, plus sokoban's, grid-atlas's and atlas-topology's.
-- `cabal test sokoban` on its own fails [Cabal-7043] rather than enabling
-- them. `tests: True` makes the plan always carry them, so a future genuine
-- solver conflict surfaces as an error instead of a skip. The `just test`
-- recipe also passes --enable-tests so the gate holds if this line is
-- dropped.
tests: True

-- sized-grid-8hx. GHC 9.14.1 ships containers-0.8, but the gloss stack still
-- caps containers <0.8 and has no 9.14 release upstream. containers is
-- non-reinstallable -- the `ghc` package, pulled in by ghc-typelits-natnormalise,
-- pins the installed instance -- so without this the solver cannot produce any
-- plan and `cabal build all` fails outright on 9.14, taking the library down
-- with it rather than just the examples.
--
-- The bound is stale, not a real incompatibility: the whole stack plus both
-- examples compiles and links against containers-0.8 on 9.14.1. Scoped to the
-- five packages that actually carry the bound rather than a blanket
-- `allow-newer: containers`, so a genuine future breakage elsewhere still
-- shows up as a solver error. No-op on 9.10/9.12, where containers is <0.8.
allow-newer:
  gloss:containers,
  gloss-rendering:containers,
  OpenGL:containers,
  GLUT:containers,
  OpenGLRaw:containers

-- sized-grid-23y3. Which gloss backend the examples get, and why it is not the
-- default one.
--
-- gloss sets the GL viewport in exactly one place for the GLUT backend --
-- Interface/ViewState/Reshape.hs, from the size GLUT's reshape callback
-- reports -- and on macOS that size is in POINTS. The framebuffer behind a
-- Retina window is twice that in PIXELS, which is the unit glViewport takes,
-- so every example rendered into the bottom-left quarter of its window with
-- the rest left as background. GLUT's own display callback never touches the
-- viewport again, so there is nothing a demo can do about it from the Picture
-- side: the viewport clips, so no amount of scaling escapes the quarter.
--
-- The GLFW backend does not have the bug. Its display callback re-reads
-- GLFW.getFramebufferSize every frame and sets the viewport from that, under a
-- comment naming the HiDPI discrepancy directly. gloss ships both behind
-- flags, defaulting to GLUT, and picks with `#ifdef WITHGLUT / #elif
-- WITHGLFW` -- so GLUT wins unless its flag is off, and both halves below are
-- load-bearing.
--
-- This does NOT drop the GLUT dependency and must not be read as trying to.
-- gloss draws text with GLUT.renderString, so the GLUT package stays (gloss
-- depends on it unconditionally) and the GLFW backend calls
-- GLUT.getArgsAndInitialize itself so that keeps working. The flag only
-- selects which windowing backend is compiled in. The cost is four more
-- packages: GLFW-b, bindings-GLFW (which bundles the GLFW C source and links
-- the Cocoa frameworks, so there is no system library to install),
-- bindings-DSL and hsc2hs.
--
-- sized-grid-vyjt: scoped to macOS. The HiDPI quarter-screen bug this works
-- around is a macOS-points-vs-pixels problem, so the GLFW backend only buys
-- anything there. On Linux, bindings-GLFW's bundled C source is not
-- self-contained the way it is on macOS (Cocoa): it needs the X11/GL dev
-- headers (libxrandr, libxi, libxinerama, libxcursor, libxxf86vm, ...) at its
-- configure step, which the CI runners do not carry, so `cabal build all`
-- died before the tests on every GHC. Keeping GLUT on non-Darwin sidesteps
-- that with no loss: the bug it papers over does not occur off macOS.
if os(darwin)
  package gloss
    flags: -GLUT +GLFW
