cabal-version:      3.0
name:               sized-grid
version:            0.3.0.0
category:           Data
build-type:         Simple
license:            MIT
license-file:       LICENSE
maintainer:         ed@wastell.co.uk
bug-reports:        https://github.com/edwardwas/sized-grid/issues
synopsis:           Multidimensional grids with sized specified at compile time
author:             edwardwas
homepage:           https://github.com/edwardwas/sized-grid
description:
  `size-grid` allows you to make finite sized grids and have their size and shape confirmed at compile time
  .
  Consult the readme for a short tutorial and explanation.

extra-source-files:
  ChangeLog.md
  README.lhs
  README.md

tested-with:        GHC ==9.8.4 || ==9.10.1 || ==9.12.3 || ==9.14.1

source-repository head
  type:     git
  location: https://github.com/edwardwas/sized-grid

-- Shared language settings. GHC2024 already implies DataKinds, GADTs,
-- LambdaCase, MonoLocalBinds, DerivingStrategies, RoleAnnotations and
-- ExplicitNamespaces on top of GHC2021, which is why the per-module LANGUAGE
-- headers are far shorter than they used to be.
common lang
  default-language:   GHC2024
  default-extensions:
    DefaultSignatures
    FunctionalDependencies
    PatternSynonyms
    TypeFamilies
    UndecidableInstances
    UndecidableSuperClasses
    ViewPatterns

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    SizedGrid
    SizedGrid.Coord
    SizedGrid.Coord.Class
    SizedGrid.Coord.HardWrap
    SizedGrid.Coord.Periodic
    SizedGrid.Grid.Class
    SizedGrid.Grid.Focused
    SizedGrid.Grid.Grid
    SizedGrid.Ordinal

  other-modules:   SizedGrid.Internal.Type
  build-depends:
    , adjunctions  >=4.4  && <4.5
    , aeson        >=2.1  && <2.3
    , base         >=4.19 && <4.23
    , comonad      >=5.0  && <5.1
    , constraints  >=0.13 && <0.15
    , distributive >=0.6  && <0.7
    , generics-sop >=0.5  && <0.6
    , lens         >=5.2  && <5.4
    , mtl          >=2.3  && <2.4
    , random       >=1.2  && <1.4
    , vector       >=0.13 && <0.14
    , vector-space >=0.16 && <0.20

test-suite tests
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        Main.hs
  other-modules:
    Test.Invariant
    Test.Shrink
    Test.Utils

  build-depends:
    , adjunctions
    , aeson
    , base
    , bytestring        >=0.11 && <0.13
    , generics-sop
    , HUnit             >=1.6  && <1.7
    , lens
    , QuickCheck        >=2.14 && <2.16
    , sized-grid
    , tasty             >=1.4  && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
    , vector
    , vector-space
