cabal-version:       3.0
name:                ising-example
version:             0.1.0.0
synopsis:            Ising model example for grid-sized
description:
  A Metropolis-Hastings simulation of the 2D Ising model on a
  @Grid '[Periodic 60, Periodic 60]@, streamed through pipes and drawn with
  gloss.
license:             MIT
license-file:        LICENSE
author:              Kevin Horlick
maintainer:          beefyhalo@gmail.com
category:            Simulation
build-type:          Simple
extra-doc-files:     ChangeLog.md

executable ising-example
  main-is:             Main.hs
  build-depends:
    , base         >=4.19 && <5
    , comonad      >=5.0  && <5.1
    , generics-sop >=0.5  && <0.6
    , gloss        >=1.13 && <1.14
    , lens         >=5.2  && <5.4
    , MonadRandom  >=0.5  && <0.7
    , mtl          >=2.3  && <2.4
    , pipes        >=4.3  && <4.4
    , random       >=1.2  && <1.4
    , grid-sized
    , vector-space >=0.16 && <0.20
  hs-source-dirs:      src
  default-language:    GHC2024
  ghc-options: -O2 -threaded -Wall
