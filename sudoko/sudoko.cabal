cabal-version:       3.0
name:                sudoko
version:             0.1.0.0
synopsis:            Sudoku solver example for sized-grid
description:
  Uses gridWindows/mapLowerDim to slice a 9x9 board into its rows, columns and
  3x3 squares, then searches for a solution. This is the driver example for the
  grid-slicing API.
license:             MIT
license-file:        LICENSE
author:              Ed Wastell
maintainer:          ed@wastell.co.uk
category:            Game
build-type:          Simple
extra-doc-files:     ChangeLog.md

executable sudoko
  main-is:             Main.hs
  -- recursion-schemes, free and lens were dependencies of an unfinished
  -- Cofree-based search that was never written; every import of them was dead.
  -- They come back when the solver does.
  build-depends:
    , base       >=4.19 && <5
    , sized-grid
  hs-source-dirs:      src
  default-language:    GHC2024
  ghc-options: -O2 -threaded -Wall
