cabal-version:       3.0
name:                sudoko
version:             0.1.0.0
synopsis:            Sudoku solver example for grid-sized
description:
  Uses gridWindows/mapLowerDim to slice a 9x9 board into its rows, columns and
  3x3 squares, then searches for a solution. This is the driver example for the
  grid-slicing API.
license:             MIT
license-file:        LICENSE
author:              Kevin Horlick
maintainer:          beefyhalo@gmail.com
category:            Game
build-type:          Simple
extra-doc-files:     ChangeLog.md

executable sudoko
  main-is:             Main.hs
  -- The solver is a direct backtracking search and needs no extra packages.
  build-depends:
    , base       >=4.19 && <5
    , grid-sized
  hs-source-dirs:      src
  default-language:    GHC2024
  ghc-options: -O2 -threaded
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Werror
