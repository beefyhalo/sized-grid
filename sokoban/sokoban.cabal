cabal-version:       3.0
name:                sokoban
version:             0.1.0.0
synopsis:            Sokoban on a Mobius strip, where the topology is the puzzle
description:
  A Sokoban whose board is a Mobius strip: one @Grid '[Clamped w, Clamped h]@
  chart glued to itself along its width with a half twist, through
  @Data.Grid.Atlas.Mobius@.
  .
  The point is that nothing in the rules knows about the twist. A push is two
  calls to @mobiusStep@ --- one for the player, one for the crate, the second
  in the frame the first landed in --- and that is the whole of the
  accommodation. Crossing the seam mirrors the axis it does not wrap, so a
  crate pushed off one end of the board arrives at the other end in the row on
  the far side of the middle, and levels are built out of exactly that.
license:             MIT
license-file:        LICENSE
author:              Kevin Horlick
maintainer:          beefyhalo@gmail.com
category:            Game
build-type:          Simple
extra-doc-files:     ChangeLog.md

-- As in grid-atlas.cabal, and for the same reason: the board's size is two
-- type-level naturals, and 'Coord' asks for KnownNat evidence about their
-- product. The plugins discharge that instead of the game proving it by hand.
-- Common stanzas are not shared between .cabal files, so this repeats them.
common lang
  default-language:   GHC2024
  default-extensions:
    TypeAbstractions
    TypeFamilies
    UndecidableInstances

  build-depends:
    , ghc-typelits-knownnat     >=0.7 && <0.9
    , ghc-typelits-natnormalise >=0.7 && <0.10

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Werror
    -fplugin=GHC.TypeLits.Normalise
    -fplugin=GHC.TypeLits.KnownNat.Solver

  if impl(ghc >= 9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Sokoban.Board
    Sokoban.Level
    Sokoban.Rules
    Sokoban.Solve

  build-depends:
    , base        >=4.20 && <4.23
    , containers  >=0.6  && <0.9
    , grid-atlas
    , grid-sized

executable sokoban
  import:          lang
  main-is:         Main.hs
  hs-source-dirs:  app
  ghc-options:     -O2 -threaded
  build-depends:
    , base
    , containers
    , sokoban

test-suite tests
  import:          lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  tests
  main-is:         Main.hs
  other-modules:
    Test.Levels
    Test.Rules
    Test.Seam

  build-depends:
    , base
    , containers
    , grid-atlas
    , grid-sized
    , HUnit             >=1.6  && <1.7
    , QuickCheck        >=2.14 && <2.16
    , sokoban
    , tasty             >=1.4  && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
