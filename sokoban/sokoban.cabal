cabal-version:       3.0
name:                sokoban
version:             0.1.0.0
synopsis:            Sokoban on a Mobius strip, where the topology is the puzzle
description:
  A Sokoban whose board is a Mobius strip: one @Grid '[Clamped w, Clamped h]@
  chart glued to itself along its width with a half twist, through
  @Data.Grid.Atlas.Mobius@.
  .
  The point is that nothing in the rules knows about the twist. A push is two
  calls to @mobiusStep@ --- one for the player, one for the crate, the second
  in the frame the first landed in --- and that is the whole of the
  accommodation. Crossing the seam mirrors the axis it does not wrap, so a
  crate pushed off one end of the board arrives at the other end in the row on
  the far side of the middle, and levels are built out of exactly that.
  .
  The window opens on a title screen, because what a Mobius strip is has to be
  said before a level is on screen rather than after. Behind the sentence that
  says it, the strip turns as an actual band. Finishing a level sends a marker
  twice around the strip --- which is what it takes to come home --- and then
  on to the next one, and a level screen shows all eight at once, ticked where
  they are done.
  .
  Plays in a window or at a terminal, and both draw the strip the same way: the
  chart as a rectangle, with the far side of each edge drawn past it, dimmed,
  in the row the seam sends it to. The consequence of a push through the seam
  is on screen before the push is made.
  .
  The window has two more ways of looking at it, neither of them for playing
  in. One draws the surface in the player's own frame, where crossing the seam
  looks like nothing at all. The other draws the strip as the band it is, twist
  and all, with its single edge in a single colour --- the one view that does
  not ask the player to take the surface on trust.
  .
  Every level ships with a proof that it needs the surface it is on. @sokoban
  --check@ solves each one three times -- on the strip, on a cylinder of the
  same shape, and on a plain rectangle of the same shape -- and reports which
  of them could also finish it. Seven of the eight built-in levels have no
  solution without the half turn.
license:             MIT
license-file:        LICENSE
author:              Kevin Horlick
maintainer:          beefyhalo@gmail.com
category:            Game
build-type:          Simple
extra-doc-files:     ChangeLog.md

-- Ships with the sdist because sokoban-shot is useless without it: it writes
-- PPMs and this is what makes one viewable.
extra-source-files:  capture/ppm2png.py

-- As in grid-atlas.cabal, and for the same reason: the board's size is two
-- type-level naturals, and 'Coord' asks for KnownNat evidence about their
-- product. The plugins discharge that instead of the game proving it by hand.
-- Common stanzas are not shared between .cabal files, so this repeats them.
common lang
  default-language:   GHC2024
  default-extensions:
    TypeAbstractions
    TypeFamilies
    UndecidableInstances

  build-depends:
    , ghc-typelits-knownnat     >=0.7 && <0.9
    , ghc-typelits-natnormalise >=0.7 && <0.10

  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Werror
    -fplugin=GHC.TypeLits.Normalise
    -fplugin=GHC.TypeLits.KnownNat.Solver

  if impl(ghc >= 9.14)
    ghc-options: -Wno-pattern-namespace-specifier

library
  import:          lang
  hs-source-dirs:  src
  exposed-modules:
    Sokoban.Band
    Sokoban.Board
    Sokoban.Flat
    Sokoban.Level
    Sokoban.Render
    Sokoban.Rules
    Sokoban.Shell
    Sokoban.Solve

  build-depends:
    , base        >=4.20 && <4.23
    , containers  >=0.6  && <0.9
    , gloss       >=1.13 && <1.14
    , grid-atlas
    , grid-sized

executable sokoban
  import:          lang
  main-is:         Main.hs
  hs-source-dirs:  app
  ghc-options:     -O2 -threaded
  build-depends:
    , base
    , containers
    , sokoban

-- Not part of the game: the harness that photographs the game's own window,
-- because this machine cannot photograph it from outside. See its header, and
-- sized-grid-23y3.
executable sokoban-shot
  import:          lang
  main-is:         Main.hs
  hs-source-dirs:  capture
  ghc-options:     -threaded
  build-depends:
    , base
    , bytestring  >=0.11 && <0.13
    , gloss
    , OpenGL      >=3.0  && <3.1
    , sokoban

test-suite tests
  import:          lang
  type:            exitcode-stdio-1.0
  hs-source-dirs:  tests
  main-is:         Main.hs
  other-modules:
    Test.Band
    Test.Levels
    Test.Rules
    Test.Seam
    Test.Shell

  build-depends:
    , base
    , containers
    , gloss
    , grid-atlas
    , grid-sized
    , HUnit             >=1.6  && <1.7
    , QuickCheck        >=2.14 && <2.16
    , sokoban
    , tasty             >=1.4  && <1.6
    , tasty-hunit       >=0.10 && <0.11
    , tasty-quickcheck  >=0.10 && <0.12
