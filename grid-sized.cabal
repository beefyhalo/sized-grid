cabal-version:      3.0
-- This package began as a fork of edwardwas' 'sized-grid' and has diverged past
-- any possible merge back: GHC 9.10+ minimum, RequiredTypeArguments throughout,
-- a sealed Grid constructor, Ordinal as a newtype over Int, and GHC2024. The
-- upstream name belongs to its author and is still his on Hackage, so this is
-- released under a new one and the version restarts accordingly.
name:               grid-sized
version:            0.1.0.0
category:           Data
build-type:         Simple
license:            MIT
license-file:       LICENSE
maintainer:         beefyhalo@gmail.com
bug-reports:        https://github.com/beefyhalo/sized-grid/issues
synopsis:           Multidimensional grids whose size and boundary policy are types
author:             Kevin Horlick
homepage:           https://github.com/beefyhalo/sized-grid
description:
  `grid-sized` provides finite, multidimensional grids whose size and shape are
  confirmed at compile time.
  .
  The design thesis: __the coordinate type is the boundary policy__. Every axis
  is indexed by a coordinate that says what happens at the edge -- `Periodic`
  wraps, `Clamped` stops -- so any operation that could leave the space is
  either total, because the type says how to come back, or it returns `Maybe`.
  Nothing clamps silently.
  .
  Consult the readme for a short tutorial and explanation.

-- README.lhs is a symlink to README.md and is the readme test-suite's main-is,
-- so it is build input rather than documentation. The compile-fail snippets
-- are build input the same way: Test.CompileFail shells out to GHC to compile
-- them directly rather than through this .cabal file, so they need listing
-- here for them to travel with an sdist.
extra-source-files:
  bench/baseline-ghc9.12.3-aarch64-darwin.csv
  README.lhs
  tests/compile-fail/*.hs
-- bench/README.md ships because the baseline CSV above ships: the numbers in
-- it are meaningless without the architecture, compiler and refresh procedure
-- that README records.
extra-doc-files:
  bench/README.md
  ChangeLog.md
  README.md

-- GHC 9.8 is no longer supported: RequiredTypeArguments, which is how sizes are
-- passed throughout the API, arrived in GHC 9.10.
tested-with:        GHC ==9.10.1 || ==9.12.3 || ==9.14.1

source-repository head
  type:     git
  location: https://github.com/beefyhalo/sized-grid

-- Shared language settings. GHC2024 already implies DataKinds, GADTs,
-- LambdaCase, MonoLocalBinds, DerivingStrategies, RoleAnnotations and
-- ExplicitNamespaces on top of GHC2021, which is why the per-module LANGUAGE
-- headers are far shorter than they used to be.
--
-- Split in two: 'lang-base' is the language and warning settings, 'lang' is
-- that plus the type-checker plugins. The only component that wants the first
-- without the second is the 'downstream' test suite, whose entire job is to
-- compile as a consumer does -- and a consumer does not get our plugins.
common lang-base
  default-language:   GHC2024
  -- TypeAbstractions is for @SCons \@xs \@x@ in Data.Grid.Sized.Coord: 'SList' has no
  -- fields, so a type abstraction is the only way to name the head and tail of
  -- the list it refines. GHC 9.12 still accepts that under TypeApplications but
  -- warns; from 9.14 it is required.
  -- RequiredTypeArguments is how sizes are passed: 'takeGrid 3 g' rather than
  -- 'takeGrid (Proxy @3) g'. It is on for every component because the tests and
  -- the README call those functions too.
  default-extensions:
    DefaultSignatures
    FunctionalDependencies
    PatternSynonyms
    RequiredTypeArguments
    TypeAbstractions
    TypeFamilies
    UndecidableInstances
    UndecidableSuperClasses
    ViewPatterns

  -- -Wmissing-export-lists is what keeps the Grid constructor sealed. Without
  -- it a module added later with a bare 'module M where' re-exposes whatever it
  -- imports, and the seal is only as good as the leakiest module.
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wmissing-export-lists -Wpartial-fields
    -Wredundant-constraints -Werror

  -- GHC 9.14 deprecates the 'pattern' namespace specifier that
  -- Data.Grid.Sized.Coord's export list uses for (:|) and EmptyCoord, in
  -- favour of 'data'. But 'data' there is a parse error on GHC 9.10/9.12
  -- (the syntax doesn't exist yet), so 'pattern' is still what every
  -- supported GHC accepts -- silence the 9.14-only deprecation instead of
  -- forking the export list per compiler.
  if impl(ghc >= 9.14)
    ghc-options: -Wno-pattern-namespace-specifier

common lang
  import: lang-base

  -- sized-grid-h56. These two solvers discharge the Nat goals this library used
  -- to state by hand with Data.Constraint.Nat: 'KnownNat (n * MaxCoordSize as)'
  -- in the AllSizedKnown instance and 'KnownNat (k + 1)' in 'reifyOrdinal'.
  --
  -- They are a build-time dependency of this library only. Plugins are not
  -- transitive -- a downstream package solves its own constraints -- so nothing
  -- here obliges a consumer to enable them, and the example packages in this
  -- project deliberately do not.
  --
  -- sized-grid-wrc. There is deliberately no third plugin here. The library's
  -- last 'unsafeCoerce' lived in 'Data.Grid.Sized.Internal.Type.windowFits', and the
  -- note that used to sit in this file said it needed ghc-typelits-presburger.
  -- That was measured, and it is true as far as it goes -- presburger does
  -- discharge the goal -- but presburger 0.7.4.2 is bounded 'ghc <9.13', as is
  -- the ghc-tcplugins-extra 0.5 beneath it, with no 9.14 branch upstream.
  -- Adding it makes GHC 9.14.1 fail to resolve outright ([Cabal-7107]): the
  -- exact trap that left h56 deferred, which natnormalise and knownnat escaped
  -- only by moving to ghc-tcplugin-api. presburger has not moved.
  --
  -- It turned out not to be needed. Restating the wanted as 'off + len <= m'
  -- ('sliceGrid' rather than 'takeGrid . dropGrid') removes the truncating
  -- subtraction, and the two steps natnormalise still will not take are named
  -- as ordinary lemmas from 'constraints', which is already a dependency. So
  -- the axiom is gone, no plugin was added, and 9.14 is kept. Before reaching
  -- for a solver here, check whether the goal can simply be stated differently.
  build-depends:
    , ghc-typelits-knownnat     >=0.7 && <0.9
    , ghc-typelits-natnormalise >=0.7 && <0.10

  ghc-options:
    -fplugin=GHC.TypeLits.Normalise
    -fplugin=GHC.TypeLits.KnownNat.Solver

library
  import:          lang
  hs-source-dirs:  src

  -- sized-grid-6os. 'unsafeOrdinal' is the single unchecked way to build an
  -- Ordinal, and it states its precondition with Control.Exception.assert --
  -- but -fignore-asserts is implied by -O, and cabal builds this component at
  -- -O1 by default. Because unsafeOrdinal is INLINE, that stripping happens
  -- once, here, when this module's unfolding is written to its interface: no
  -- flag on a downstream component (the test suite included) can bring the
  -- check back, since it links against the already-stripped unfolding. This
  -- has to be set where unsafeOrdinal is defined, which makes the check live
  -- for every consumer, not just this package's own test suite. That is
  -- intentional: an out-of-range Ordinal indexes a vector out of bounds or
  -- silently reads the wrong cell, so a few comparisons on coord arithmetic
  -- (Clamped's Semigroup and AffineSpace instances, Periodic's Semigroup and
  -- toEnum) are cheap insurance against that everywhere, not just in CI.
  --
  -- sized-grid-adr.6. The optimisation flags below, and the order they are in.
  -- What this library sells is a per-axis fold written as a class method (see
  -- the long note on 'IsCoordList') that unrolls into literal arithmetic once
  -- the dictionary is known. For a downstream package that happens at
  -- specialisation, which needs the unfoldings to be in the interface file --
  -- so whether they are there is the whole question, and it was measured.
  --
  -- The answer is: a little, in two places, and nowhere else. Against the
  -- benchmark suite, which is a separate component and so reads these .hi
  -- files exactly as a downstream package does, two of forty-eight benchmarks
  -- move and none regress:
  --
  --   imap 300x300      2.0x, allocation to 0.64x
  --   ifoldl' 300x300   1.5x, allocation to essentially nothing
  --
  -- Everything else is inside the noise, and ../aoc -- the real consumer --
  -- does not move at all: two of its grid puzzles land within a percent of
  -- where they were, because their time is in parsing and list building rather
  -- than in coord arithmetic.
  --
  -- Be careful measuring this. The first pass at it put the flags in a
  -- `package grid-sized` stanza in a cabal.project, which applies to every
  -- component of the package and so rebuilt the benchmark itself with -O2 and
  -- -fspecialise-aggressively. That reported sixteen moved benchmarks and a
  -- 27x on toEnum/fromEnum -- all of it the benchmark's own compilation, not
  -- this library's unfoldings. The honest experiment changes only the library
  -- stanza and leaves the benchmark at -O1 on both sides; the allocation
  -- column is what gives the difference away, since it does not drift.
  --
  -- The cost is small enough to keep the two wins for: this component builds
  -- 5% slower, its .hi files grow 10%, and a downstream recompile against them
  -- does not change (8.1s either way). Bigger unfoldings usually mean slower
  -- downstream compiles; at this size they do not.
  --
  -- sized-grid-sxy. GUARD: -O implies -fignore-asserts, and the last
  -- occurrence of a GHC flag on the command line wins. That is not
  -- hypothetical -- it was measured on the way in: with -O2 written after
  -- -fno-ignore-asserts, a consumer forcing an out-of-range
  -- 'unsafeOrdinal 99 :: Ordinal 5' printed 99 rather than failing, and the
  -- 8% those flags appeared to buy that consumer was entirely the missing
  -- check. So -fno-ignore-asserts is last on the line below and MUST stay
  -- last, after any optimisation flag added here later. The same trap is open
  -- to a `package grid-sized` stanza in someone's cabal.project, whose
  -- ghc-options are appended after these: an -O2 there strips the check again
  -- and nothing in this file can stop it. The 'downstream' test suite states
  -- this as a check, which is the only place it can be stated from.
  ghc-options:
    -O2 -fexpose-all-unfoldings -fspecialise-aggressively -fno-ignore-asserts

  exposed-modules:
    Data.Grid.Sized
    Data.Grid.Sized.Class
    Data.Grid.Sized.Coord
    Data.Grid.Sized.Coord.Clamped
    Data.Grid.Sized.Coord.Class
    Data.Grid.Sized.Coord.Periodic
    Data.Grid.Sized.Coord.Reflect101
    Data.Grid.Sized.Coord.Reflective
    Data.Grid.Sized.Focused
    Data.Grid.Sized.Ordinal
    Data.Grid.Sized.Stencil
    Data.Grid.Sized.Unboxed
    Data.Grid.Sized.Unsafe

  -- Data.Grid.Sized.Internal.Grid holds the Grid constructor. It is hidden rather
  -- than exposed so that "Data.Grid.Sized.Unsafe" can be the only public route
  -- to it; see the header of either module.
  other-modules:
    Data.Grid.Sized.Internal.Error
    Data.Grid.Sized.Internal.Grid
    Data.Grid.Sized.Internal.Type
  build-depends:
    , adjunctions  >=4.4  && <4.5
    , aeson        >=2.1  && <2.3
    , base         >=4.20 && <4.23
    , comonad      >=5.0  && <5.1
    , constraints  >=0.13 && <0.15
    , deepseq      >=1.4  && <1.6
    , distributive >=0.6  && <0.7
    , generics-sop >=0.5  && <0.6
    , groups       >=0.5  && <0.6
    , lens         >=5.2  && <5.4
    , mtl          >=2.3  && <2.4
    , random       >=1.2  && <1.4
    , vector       >=0.13 && <0.14
    , vector-space >=0.16 && <0.20

test-suite tests
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests
  main-is:        Main.hs
  other-modules:
    Test.Arbitrary
    Test.Boundary
    Test.CompileFail
    Test.Focused
    Test.Invariant
    Test.Neighbours
    Test.Ordinal
    Test.Path
    Test.Periodic
    Test.Ray
    Test.Reflective
    Test.Shrink
    Test.Stencil
    Test.Tiling
    Test.Unboxed
    Test.Utils
    Test.Windows

  build-depends:
    , adjunctions
    , aeson
    , base
    , bytestring          >=0.11 && <0.13
    , comonad
    , distributive
    , generics-sop
    , HUnit               >=1.6  && <1.7
    , lens
    , process             >=1.6  && <1.7
    , QuickCheck          >=2.14 && <2.16
    , quickcheck-classes  >=0.6  && <0.7
    , grid-sized
    , tasty               >=1.4  && <1.6
    , tasty-hunit         >=0.10 && <0.11
    , tasty-quickcheck    >=0.10 && <0.12
    , vector
    , vector-space

-- sized-grid-k6n. What this library's constraints cost a *consumer*, which is
-- not the same question as whether the library compiles: '-fplugin' is not
-- transitive, so a downstream package solves its own Nat goals with no solver
-- but GHC's. That is why this component imports 'lang-base' rather than 'lang'
-- and must keep doing so -- adding the plugins here would make it agree with
-- the rest of the tree and stop testing anything.
test-suite downstream
  import:         lang-base
  type:           exitcode-stdio-1.0
  hs-source-dirs: tests-downstream
  main-is:        Main.hs
  build-depends:
    , aeson
    , base
    , bytestring
    , grid-sized

-- Compiles README.lhs so the tutorial cannot rot unnoticed. markdown-unlit is
-- what turns the ```haskell fences into the literate source GHC sees.
test-suite readme
  import:             lang
  type:               exitcode-stdio-1.0
  main-is:            README.lhs
  build-depends:
    , base
    , comonad
    , lens
    , grid-sized
    , vector-space

  build-tool-depends: markdown-unlit:markdown-unlit >=0.5 && <0.7
  ghc-options:        -pgmL markdown-unlit

-- Baseline for the Ordinal-representation, allCoord-caching and unboxed-Grid
-- work, none of which is judgeable without numbers. tasty-bench rather than
-- criterion: one small dependency that already shares tasty with the test
-- suite.
benchmark benchmarks
  import:         lang
  type:           exitcode-stdio-1.0
  hs-source-dirs: bench
  main-is:        Main.hs
  build-depends:
    , adjunctions
    , aeson
    , base
    , comonad
    , deepseq      >=1.4  && <1.6
    , lens
    , grid-sized
    , tasty-bench  >=0.3  && <0.5
    , vector
    , vector-space

  ghc-options:    -with-rtsopts=-T

